<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- Vehicle types -->
    <vType id="passenger" accel="2.0" decel="4.5" sigma="0.5" length="5" minGap="2.5" maxSpeed="60" guiShape="passenger"/>
    
    <!-- Routes -->
    <!-- North to South (straight) -->
    <route id="route_n_s" edges="e1 e7"/>
    <!-- North to East (left) -->
    <route id="route_n_e" edges="e1 e6"/>
    <!-- North to West (right) -->
    <!-- <route id="route_n_w" edges="e1 e8"/> -->
    
    <!-- East to West (straight) -->
    <route id="route_e_w" edges="e2 e8"/>
    <!-- East to North (right) -->
    <route id="route_e_n" edges="e2 e5"/>
    <!-- East to South (left) -->
    <!-- <route id="route_e_s" edges="e2 e7"/> -->
    
    <!-- South to North (straight) -->
    <route id="route_s_n" edges="e3 e5"/>
    <!-- South to West (left) -->
    <route id="route_s_w" edges="e3 e8"/>
    <!-- South to East (right) -->
    <!-- <route id="route_s_e" edges="e3 e6"/> -->
    
    <!-- West to East (straight) -->
    <route id="route_w_e" edges="e4 e6"/>
    <!-- West to South (right) -->
    <route id="route_w_s" edges="e4 e7"/>
    <!-- West to North (left) -->
    <!-- <route id="route_w_n" edges="e4 e5"/> -->
    
    <!-- Vehicle flows (3600 vehicles per hour for each direction) = 1 vehicle per second -->
    <flow id="flow_n_s_1" type="passenger" route="route_n_s" begin="0" end="3600" vehsPerHour="600" departLane="0" departSpeed="random"/>
    <flow id="flow_n_s_2" type="passenger" route="route_n_s" begin="0" end="3600" vehsPerHour="600" departLane="1" departSpeed="random"/>
    <flow id="flow_n_s_3" type="passenger" route="route_n_s" begin="0" end="3600" vehsPerHour="600" departLane="2" departSpeed="random"/>
    <flow id="flow_n_e" type="passenger" route="route_n_e" begin="0" end="3600" vehsPerHour="300"/>
    <!-- <flow id="flow_n_w" type="passenger" route="route_n_w" begin="0" end="3600" vehsPerHour="300"/> -->
    
    <flow id="flow_e_w_1" type="passenger" route="route_e_w" begin="0" end="3600" vehsPerHour="300" departLane="1" departSpeed="random"/>
    <flow id="flow_e_w_2" type="passenger" route="route_e_w" begin="0" end="3600" vehsPerHour="300" departLane="2" departSpeed="random"/>
    <flow id="flow_e_w_3" type="passenger" route="route_e_w" begin="0" end="3600" vehsPerHour="300" departLane="3" departSpeed="random"/>
    <flow id="flow_e_n" type="passenger" route="route_e_n" begin="0" end="3600" vehsPerHour="400"/>
    <!-- <flow id="flow_e_s" type="passenger" route="route_e_s" begin="0" end="3600" vehsPerHour="300"/> -->
    
    <flow id="flow_s_n_1" type="passenger" route="route_s_n" begin="0" end="3600" vehsPerHour="600" departLane="0" departSpeed="random"/>
    <flow id="flow_s_n_2" type="passenger" route="route_s_n" begin="0" end="3600" vehsPerHour="600" departLane="1" departSpeed="random"/>
    <flow id="flow_s_n_3" type="passenger" route="route_s_n" begin="0" end="3600" vehsPerHour="600" departLane="2" departSpeed="random"/>
    <flow id="flow_s_w" type="passenger" route="route_s_w" begin="0" end="3600" vehsPerHour="300"/>
    <!-- <flow id="flow_s_e" type="passenger" route="route_s_e" begin="0" end="3600" vehsPerHour="300"/> -->
    
    <flow id="flow_w_e_1" type="passenger" route="route_w_e" begin="0" end="3600" vehsPerHour="300" departLane="1" departSpeed="random"/>
    <flow id="flow_w_e_2" type="passenger" route="route_w_e" begin="0" end="3600" vehsPerHour="300" departLane="2" departSpeed="random"/>
    <flow id="flow_w_e_3" type="passenger" route="route_w_e" begin="0" end="3600" vehsPerHour="300" departLane="3" departSpeed="random"/>
    <flow id="flow_w_s" type="passenger" route="route_w_s" begin="0" end="3600" vehsPerHour="400"/>
    <!-- <flow id="flow_w_n" type="passenger" route="route_w_n" begin="0" end="3600" vehsPerHour="300"/> -->
</routes>